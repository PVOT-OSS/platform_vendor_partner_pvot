// https://github.com/PVOT-OSS/PvotCalculator/releases
android_app_import {
    name: "PvotCalculator",
    certificate: "platform",
    product_specific: true,
    overrides: [
        "ExactCalculator",
    ],
    optional_uses_libs: [
        "org.apache.http.legacy",
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    apk: "PvotCalculator-v1.0.0-release.apk",
}
